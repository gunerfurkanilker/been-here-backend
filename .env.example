# Uygulama Ayarları
NODE_ENV=development
PORT=3000
DEV_MOCK_EXTERNAL_SERVICES=true

# PostgreSQL + PostGIS Veritabanı
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=beenhere
DB_PASSWORD=beenhere_secret
DB_NAME=been_here_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# pgAdmin 4 (Tarayıcı Arayüzü: http://localhost:5050)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@beenhere.app
PGADMIN_DEFAULT_PASSWORD=admin123

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase Admin SDK (DEV_MOCK_EXTERNAL_SERVICES=true iken boş bırakılabilir)
FIREBASE_PROJECT_ID=been-here-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Places API (DEV_MOCK_EXTERNAL_SERVICES=true iken mock veri döner)
GOOGLE_PLACES_API_KEY=
PLACE_LAZY_REFRESH_DAYS=30

# Cloudflare R2 (S3 Uyumlu Depolama)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=been-here-media
R2_PUBLIC_BASE_URL=https://media.beenhere.app
R2_PRESIGNED_URL_EXPIRES_SECONDS=900

# Üyelik Kotaları ve İş Kuralları (Dinamik Konfigürasyon)
QUOTA_FREE_MAX_DRAFT_ROUTES=3
QUOTA_FREE_MAX_UNPUBLISHED_EDIT_DRAFTS=1
QUOTA_FREE_MAX_STOPS_PER_ROUTE=20
QUOTA_FREE_MAX_PHOTOS_PER_STOP=3
QUOTA_FREE_MAX_PRIVATE_MEMORIES=5
QUOTA_FREE_MAX_PLACE_LISTS=3
QUOTA_FREE_MAX_PLACES_PER_LIST=10
TRUST_SCORE_SHADOWBAN_THRESHOLD=50
